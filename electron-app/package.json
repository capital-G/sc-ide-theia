{
  "private": true,
  "name": "electron-app",
  "version": "0.0.0",
  "main": "lib/backend/electron-main.js",
  "dependencies": {
    "@theia/core": "1.74.1",
    "@theia/editor": "1.74.1",
    "@theia/electron": "1.74.1",
    "@theia/file-search": "1.74.1",
    "@theia/filesystem": "1.74.1",
    "@theia/markers": "1.74.1",
    "@theia/messages": "1.74.1",
    "@theia/monaco": "1.74.1",
    "@theia/navigator": "1.74.1",
    "@theia/plugin-ext": "1.74.1",
    "@theia/plugin-ext-vscode": "1.74.1",
    "@theia/preferences": "1.74.1",
    "@theia/process": "1.74.1",
    "@theia/search-in-workspace": "1.74.1",
    "@theia/terminal": "1.74.1",
    "@theia/workspace": "1.74.1",
    "SuperColliderIDE": "0.0.0"
  },
  "devDependencies": {
    "@theia/cli": "1.74.1",
    "electron": "42.3.0"
  },
  "scripts": {
    "bundle": "npm run rebuild && npm run download:plugins && theia build --mode development",
    "download:plugins": "theia download:plugins",
    "rebuild": "theia rebuild:electron --cacheRoot ..",
    "start": "theia start --plugins=local-dir:plugins",
    "watch": "npm run rebuild && theia build --watch --mode development"
  },
  "theiaPluginsDir": "plugins",
  "theiaPlugins": {
    "vscode.git": "https://open-vsx.org/api/vscode/git/1.95.3/file/vscode.git-1.95.3.vsix",
    "vscodevim.vim": "https://open-vsx.org/api/vscodevim/vim/1.32.4/file/vscodevim.vim-1.32.4.vsix"
  },
  "theia": {
    "target": "electron",
    "frontend": {
      "config": {
        "applicationName": "SuperCollider IDE"
      }
    }
  }
}
